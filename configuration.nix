# Entry point. Intentionally tiny: what to import lives in modules/default.nix,
# per-machine values live in settings.nix.
let
  settings = import ./settings.nix;
in
{ ... }:
{
  imports = [
    ./hardware-configuration.nix # generated by nixos-generate-config, never edit
    ./modules
  ];

  # Hand `settings` to every module as an argument: { settings, ... }:
  _module.args.settings = settings;

  # Do not change after install, even when upgrading NixOS.
  system.stateVersion = settings.stateVersion;
}
