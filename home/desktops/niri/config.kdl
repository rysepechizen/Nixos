// ════════════════════════════════════════════════════════════════
//            niri config  —  managed by Home Manager
//   Source: home/desktops/niri/  (edit there, then `rebuild`)
// ════════════════════════════════════════════════════════════════

include "./cfg/autostart.kdl"   // programs launched at login (Noctalia)
include "./cfg/keybinds.kdl"    // all keyboard / mouse / media shortcuts
include "./cfg/input.kdl"       // keyboard, touchpad, focus behaviour
include "./cfg/display.kdl"     // monitor mode, scale, position  (per machine!)
include "./cfg/layout.kdl"      // gaps, focus ring, shadow, tabs, overview
include "./cfg/animation.kdl"   // spring / easing animation tuning
include "./cfg/rules.kdl"       // per-window and per-layer rules
include "./cfg/misc.kdl"        // environment, cursor, screenshots, CSD

// Theme colours generated by Noctalia at runtime (not part of this repo).
// Home Manager creates an empty placeholder until Noctalia writes the real one.
include "./noctalia.kdl"
